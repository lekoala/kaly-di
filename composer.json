{
    "name": "lekoala/kaly-di",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas",
            "email": "thomas@lekoala.be"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/container": "^1.1.2|^2.0.2"
    },
    "require-dev": {
        "carthage-software/mago": "^1",
        "composer/ca-bundle": "^1.5",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Kaly\\Di\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kaly\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@phpunit",
            "@phpstan",
            "@mago:lint",
            "@mago:format"
        ],
        "phpunit": "@php -d zend.assertions=1 vendor/bin/phpunit",
        "phpstan": "phpstan analyse src --memory-limit=-1",
        "mago:lint": "mago lint --minimum-report-level warning src tests",
        "mago:format": "mago fmt --check",
        "fmt": "mago fmt"
    },
    "prefer-stable": true
}
